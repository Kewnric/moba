{
  "name": "jungleros",
  "private": true,
  "version": "2.0.0",
  "description": "MLBB draft assistant that recommends a jungler for the current matchup",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node -e \"require('fs').copyFileSync('dist/index.html', 'index.html')\"",
    "preview": "vite preview",
    "test": "vitest run",
    "update-stats": "node scripts/update-stats.mjs"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.1.1",
    "autoprefixer": "10.6.0",
    "postcss": "8.5.28",
    "tailwindcss": "3.4.19",
    "vite": "8.3.0",
    "vite-plugin-singlefile": "2.3.3",
    "vitest": "5.0.0"
  }
}
